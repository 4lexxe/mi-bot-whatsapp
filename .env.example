# Configuración del Navegador para Gemini Web Scraping (0 APIs)
# HEADLESS=false para ver el navegador e iniciar sesión en Google la primera vez. Luego puedes cambiar a true.
HEADLESS=false

# Ruta donde se guardará la sesión iniciada de Google para Gemini Web
GEMINI_USER_DATA_DIR=./.gemini_chrome_data

# Configuración de WhatsApp
# Nombre o etiqueta para identificar la cuenta del bot
BOT_NAME=Gemini

# Tiempo de espera (ms) para agrupar mensajes seguidos del usuario (debounce)
BOT_DEBOUNCE_MS=3000

# Responder a todos los mensajes sin mención ni cita (true/false)
RESPOND_TO_ALL=false

